trigger:
  branches:
    include:
    - main
pool:
  name: SelfHostedPool
variables:
[REDACTED: line matched a sensitive-data pattern]
- name: serviceConnection
  value: DMI-Epicbook-Connection
- name: tfDir
  value: $(System.DefaultWorkingDirectory)/terraform
- name: adminIp
  value: '102.88.113.91'
- name: agentIp
  value: '13.53.129.254'
stages:
- stage: Validate
  displayName: Validate
  jobs:
  - job: validate
    steps:
    - task: AzureCLI@2
      displayName: Terraform fmt, init, validate
      inputs:
        azureSubscription: $(serviceConnection)
        scriptType: bash
        scriptLocation: inlineScript
        addSpnToEnvironment: true
        inlineScript: |
[REDACTED: line matched a sensitive-data pattern]
[REDACTED: line matched a sensitive-data pattern]
          export ARM_TENANT_ID="$tenantId"
          export ARM_SUBSCRIPTION_ID="$(az account show --query id -o tsv)"
          cd $(tfDir)
          terraform fmt -check -recursive
          terraform init -input=false
          terraform validate
      env:
[REDACTED: line matched a sensitive-data pattern]
        TF_VAR_allowed_admin_ip: $(adminIp)
        TF_VAR_pipeline_agent_ip: $(agentIp)
- stage: Plan
  displayName: Plan
  dependsOn:
  - Validate
  jobs:
  - job: plan
    steps:
    - task: AzureCLI@2
      displayName: Terraform plan (saved and encrypted)
      inputs:
        azureSubscription: $(serviceConnection)
        scriptType: bash
        scriptLocation: inlineScript
        addSpnToEnvironment: true
        inlineScript: |
[REDACTED: line matched a sensitive-data pattern]
[REDACTED: line matched a sensitive-data pattern]
          export ARM_TENANT_ID="$tenantId"
          export ARM_SUBSCRIPTION_ID="$(az account show --query id -o tsv)"
          cd $(tfDir)
          terraform init -input=false
          terraform plan -input=false -out=tfplan
          mkdir -p $(Build.ArtifactStagingDirectory)/plan
          terraform show -no-color tfplan > $(Build.ArtifactStagingDirectory)/plan/plan.txt
[REDACTED: line matched a sensitive-data pattern]
          rm -f tfplan
      env:
[REDACTED: line matched a sensitive-data pattern]
        TF_VAR_allowed_admin_ip: $(adminIp)
        TF_VAR_pipeline_agent_ip: $(agentIp)
    - task: PublishPipelineArtifact@1
      displayName: Publish reviewed plan
      inputs:
        targetPath: $(Build.ArtifactStagingDirectory)/plan
        artifact: tfplan
- stage: Approve
  displayName: Approve
  dependsOn:
  - Plan
  jobs:
  - job: waitForApproval
    pool:
      name: server
    timeoutInMinutes: 1500
    steps:
    - task: ManualValidation@0
      timeoutInMinutes: 1440
      inputs:
        instructions: 'Review the Terraform plan in the Plan stage, then Resume to apply or Reject to stop.'
        onTimeout: reject
- stage: Apply
  displayName: Apply
  dependsOn:
  - Approve
  jobs:
  - job: apply
    steps:
    - task: DownloadPipelineArtifact@2
      displayName: Download reviewed plan
      inputs:
        artifact: tfplan
        path: $(Pipeline.Workspace)/tfplan
    - task: AzureCLI@2
      displayName: Terraform apply (reviewed plan) and outputs
      inputs:
        azureSubscription: $(serviceConnection)
        scriptType: bash
        scriptLocation: inlineScript
        addSpnToEnvironment: true
        inlineScript: |
[REDACTED: line matched a sensitive-data pattern]
[REDACTED: line matched a sensitive-data pattern]
          export ARM_TENANT_ID="$tenantId"
          export ARM_SUBSCRIPTION_ID="$(az account show --query id -o tsv)"
          cd $(tfDir)
          terraform init -input=false
[REDACTED: line matched a sensitive-data pattern]
          terraform apply -input=false tfplan
          rm -f tfplan
          echo "===== Non-sensitive outputs ====="
          echo "app_public_ip        = $(terraform output -raw app_public_ip)"
          echo "backend_ansible_host = $(terraform output -raw backend_ansible_host)"
          echo "backend_private_ip   = $(terraform output -raw backend_private_ip)"
          echo "mysql_fqdn           = $(terraform output -raw mysql_fqdn)"
      env:
[REDACTED: line matched a sensitive-data pattern]
        TF_VAR_allowed_admin_ip: $(adminIp)
        TF_VAR_pipeline_agent_ip: $(agentIp)


