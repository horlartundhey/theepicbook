stages:
- stage: Validate
  displayName: Validate Ansible
  jobs:
  - job: validate
    steps:
    - task: 6d15af64-176c-496d-b583-fd2ae21d4df4@1
      inputs:
        repository: self
    - task: CmdLine@2
      displayName: Install Node dependencies (npm ci)
      inputs:
        script: |
          node --version
          npm ci --omit=dev --no-audit --no-fund
    - task: DownloadSecureFile@1
      name: sshKey
      displayName: Download SSH key from Secure Files
      inputs:
        secureFile: epicbook-key
    - task: CmdLine@2
      displayName: Restrict key permissions
      inputs:
        script: chmod 600 "$(sshKey.secureFilePath)"
    - task: CmdLine@2
      displayName: Syntax check and SSH connectivity
      env:
        ANSIBLE_DEPRECATION_WARNINGS: 'false'
      inputs:
        script: |
          ansible-galaxy collection install -r ansible/requirements.yml
          ansible-playbook -i ansible/inventory/hosts.ini ansible/site.yml --syntax-check
